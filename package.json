{
  "name": "ml-interview-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run index",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "index": "node scripts/build-curriculum-index.mjs",
    "validate": "node scripts/validate-curriculum.mjs",
    "prebuild": "npm run index",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "vitest run",
    "check": "npm run index && ASTRO_TELEMETRY_DISABLED=1 astro check && npm run test && npm run validate && npm run build",
    "practice": "node scripts/create-practice-workspace.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/starlight": "^0.42.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@lezer/highlight": "^1.2.5",
    "astro": "^7.3.3",
    "codemirror": "^6.0.2",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "mermaid": "^11.11.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
