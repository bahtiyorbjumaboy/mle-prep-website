---
import AppLayout from '@/layouts/AppLayout.astro'; import EmptyState from '@/components/EmptyState.astro'; import Badge from '@/components/Badge.astro'; import { index,allItems,itemHref,curriculumLabel } from '@/lib/data'; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<AppLayout title="Review queue"><header class="page-head"><div><p class="eyebrow">Review queue</p><h1>Revisit what matters, when it matters.</h1><p>Dates come from your explicit progress settings; no scheduling algorithm is imposed.</p></div><div class="button-row"><button class="button secondary" data-export>Export progress</button><label class="button secondary" for="review-import">Import</label><input id="review-import" type="file" data-import accept="application/json" hidden/></div></header>{allItems.length===0?<EmptyState/>:<><div class="filter-bar"><select data-review-sort aria-label="Sort reviews"><option value="date">Oldest due</option><option value="curriculum">Curriculum</option><option value="mastery">Mastery</option><option value="type">Knowledge vs coding</option></select><select data-filter="curriculum"><option value="">All curricula</option>{index.curricula.map(c=><option value={c.id}>{c.id}</option>)}</select></div>{[['overdue','Overdue'],['today','Due today'],['upcoming','Upcoming'],['none','No review date']].map(([group,label])=><section class="review-group" data-review-group={group}><div class="section-title"><h2>{label}</h2><Badge data-group-count>0</Badge></div><div class="item-list" data-review-list>{allItems.map(item=><article class="item-row" data-review-item data-progress-key={item.canonicalKey} data-curriculum={item.curriculum} data-type={'bank' in item?'knowledge':'coding'} hidden><a class="item-id" href={`${base}${itemHref(item.canonicalKey)}`}>{item.id}</a><a href={`${base}${itemHref(item.canonicalKey)}`}><div class="item-title">{'bank' in item?item.titleOrQuestion:item.title}</div><div class="item-meta">{curriculumLabel(item.curriculum)} · <span data-review-meta>No review date</span></div></a><div class="item-actions"><Badge><span data-status>Not started</span></Badge><button class="button secondary" data-mark-reviewed={item.canonicalKey}>Mark reviewed</button></div></article>)}</div></section>)}</>}
</AppLayout>
