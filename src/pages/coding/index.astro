---
import AppLayout from '@/layouts/AppLayout.astro'; import EmptyState from '@/components/EmptyState.astro'; import Badge from '@/components/Badge.astro';
import { index,itemHref,curriculumLabel } from '@/lib/data'; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const link=(p:string)=>`${base}${p}`;
const tracks=[...new Set(index.codingItems.map(x=>x.track))], levels=[...new Set(index.codingItems.map(x=>x.level).filter(Boolean))], formats=[...new Set(index.codingItems.map(x=>x.format).filter(Boolean))];
---
<AppLayout title="Coding"><header class="page-head"><div><p class="eyebrow">Coding practice</p><h1>What should you practice next?</h1><p>Filter the source-backed problem set by track, exposure week, or mastery.</p></div></header>
{index.codingItems.length===0?<EmptyState message="Add a canonical coding-set Markdown file under a curriculum sources directory. No practice prompts are fabricated."/>:<><div class="filter-bar"><input type="search" placeholder="Search title, prompt, concept, or ID…" data-filter="text"/><select data-filter="curriculum"><option value="">All curricula</option>{index.curricula.map(c=><option value={c.id}>{c.label}</option>)}</select><select data-filter="track"><option value="">All tracks</option>{tracks.map(x=><option>{x}</option>)}</select><select data-filter="level"><option value="">All levels</option>{levels.map(x=><option>{x}</option>)}</select><select data-filter="format"><option value="">All formats</option>{formats.map(x=><option>{x}</option>)}</select><label class="check-field"><input type="checkbox" data-filter="incomplete"/> Incomplete</label></div>
<div class="item-list">{index.codingItems.map(item=><article class="item-row" data-filter-item data-progress-key={item.canonicalKey} data-search={`${item.id} ${item.title} ${item.prompt||''} ${item.concepts.join(' ')}`.toLowerCase()} data-curriculum={item.curriculum} data-track={item.track} data-level={item.level||''} data-format={item.format||''}><a class="item-id" href={link(itemHref(item.canonicalKey))}>{item.id}</a><a href={link(itemHref(item.canonicalKey))}><div class="item-title">{item.title}</div><div class="item-meta">{curriculumLabel(item.curriculum)} · {item.track}{item.firstExposureWeek?` · Week ${item.firstExposureWeek}`:''}{item.timeBox?` · ${item.timeBox}`:''}</div></a><div class="item-actions">{item.level&&<Badge tone="blue">{item.level}</Badge>}<Badge><span data-status>Not started</span></Badge><button class="button secondary" data-toggle-complete={item.canonicalKey}>Toggle done</button></div></article>)}</div></>}
</AppLayout>
