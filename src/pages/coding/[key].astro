---
import AppLayout from '@/layouts/AppLayout.astro'; import Badge from '@/components/Badge.astro'; import ProgressControls from '@/components/ProgressControls.astro'; import ReadingControls from '@/components/ReadingControls.astro';
import { index,curriculumLabel } from '@/lib/data'; import { renderMarkdown } from '@/lib/markdown';
export function getStaticPaths(){return index.codingItems.map(item=>({params:{key:item.canonicalKey},props:{item}}));}
const { item }=Astro.props; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const link=(p:string)=>`${base}${p}`; const solution=index.codingSolutions.find(x=>x.item===item.canonicalKey); const source=index.sources.find(x=>x.path===item.sourceFile); const sourceSlug=source?`${source.curriculum}/${source.filename.replace(/\.mdx?$/,'')}`:'';
const problemHtml = await renderMarkdown(item.rawSection);
---
<AppLayout title={`${item.id} · Coding`}><header class="page-head"><div><p class="eyebrow">{curriculumLabel(item.curriculum)} · {item.track}</p><h1>{item.id}: {item.title}</h1><p class="source-path">{item.canonicalKey}</p></div><div class="button-row"><ReadingControls/>{solution&&<a class="button" href={link(`/coding-solutions/${solution.slug}/`)}>Coding solution</a>}<a class="button secondary" href={link('/coding/')}>Back to coding</a></div></header>
<div class="detail-grid"><article class="card detail-main"><div class="tabs"><a class="active" href="#prompt">Problem</a>{solution&&<a href={link(`/coding-solutions/${solution.slug}/`)}>Coding Solution</a>}</div><div id="prompt" class="prose" set:html={problemHtml} />{solution&&<section><h2>Coding Solution</h2><a class="item-row" href={link(`/coding-solutions/${solution.slug}/`)}><span class="item-id">SOLUTION</span><span class="item-title">{solution.filename}</span><Badge tone="blue">{solution.language}</Badge></a></section>}</article>
<aside class="card detail-side"><h2 style="margin-top:0">Problem details</h2><dl class="metadata"><div><dt>Track</dt><dd>{item.track}</dd></div><div><dt>Level</dt><dd>{item.level||'—'}</dd></div><div><dt>First exposure</dt><dd>{item.firstExposureWeek?`Week ${item.firstExposureWeek}`:'—'}</dd></div><div><dt>Time box</dt><dd>{item.timeBox||'—'}</dd></div><div><dt>Format</dt><dd>{item.format||'—'}</dd></div><div><dt>Source</dt><dd>{source?<a style="color:var(--brand)" href={link(`/sources/${sourceSlug}/`)}>{source.filename}</a>:item.sourceFile}</dd></div></dl>{item.concepts.length>0&&<><h3>Core concepts</h3><div class="id-links">{item.concepts.map((x:string)=><span>{x}</span>)}</div></>}{item.complexity&&<><h3>Complexity / target</h3><p class="lede">{item.complexity}</p></>}{item.requiredMastery&&<><h3>Required mastery</h3><p class="lede">{item.requiredMastery}</p></>}<ProgressControls itemKey={item.canonicalKey} curriculum={item.curriculum}/></aside></div>
</AppLayout>
