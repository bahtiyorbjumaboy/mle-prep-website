---
import AppLayout from '@/layouts/AppLayout.astro';
import Badge from '@/components/Badge.astro';
import { index, itemByKey, curriculumLabel } from '@/lib/data';
import { renderMarkdown } from '@/lib/markdown';
import { renderCode } from '@/lib/code';
export function getStaticPaths(){return index.practiceArtifacts.map(artifact=>({params:{key:artifact.item},props:{artifact}}));}
const {artifact}=Astro.props; const item:any=itemByKey.get(artifact.item||'');
const base=import.meta.env.BASE_URL.replace(/\/$/,''); const link=(p:string)=>`${base}${p}`;
const items=index.practiceArtifacts.map(a=>itemByKey.get(a.item||'')).filter(Boolean) as any[]; const position=items.findIndex(x=>x.canonicalKey===item.canonicalKey); const previous=items[position-1], next=items[position+1];
const solution=index.codingSolutions.find(x=>x.item===item.canonicalKey); const promptHtml=await renderMarkdown(item.rawSection); const solutionHtml=solution?await renderCode(solution.code,solution.language):null;
const payload={canonicalKey:item.canonicalKey,language:artifact.language,runtime:artifact.runtime,browserRunnable:artifact.browserRunnable,starterCode:artifact.starterCode,testCode:artifact.testCode,setupCode:artifact.setupCode,packages:artifact.packages,timeoutMs:artifact.timeoutMs,testKinds:artifact.testKinds};
---
<AppLayout title={`${item.id} · Practice`}><header class="page-head practice-head"><div><p class="eyebrow">{curriculumLabel(item.curriculum)} · {item.track}</p><h1>{item.id}: {item.title}</h1><p class="source-path">{item.canonicalKey}</p></div><div class="button-row"><a class="button secondary" href={link(`/coding/${encodeURIComponent(item.canonicalKey)}/`)}>Problem</a>{solution&&<a class="button secondary" href="#solution" data-reveal-solution>Solution</a>}<a class="button secondary" href={link('/coding/')}>Back to Coding</a></div></header>
<div class="practice-shell" data-practice-root data-payload={JSON.stringify(payload)}>
  <section class="card practice-prompt"><div class="tabs"><a href={link(`/coding/${encodeURIComponent(item.canonicalKey)}/`)}>Problem</a><a class="active" href="#prompt" data-left-tab="prompt">Practice</a>{solution&&<a href="#solution" data-left-tab="solution" data-reveal-solution>Solution</a>}</div><div data-left-panel="prompt"><div class="practice-facts"><Badge tone="blue">{artifact.runtime}</Badge><Badge>{item.level||'—'}</Badge><Badge>{item.timeBox||'Untimed'}</Badge><Badge>{item.format||'Practice'}</Badge></div><div class="prose" set:html={promptHtml}/></div>{solution&&<div id="solution" class="solution-panel" data-left-panel="solution" hidden><p class="lede">Reference solution. Revealing this never changes your draft or mastery.</p><div class="code-file" set:html={solutionHtml}/></div>}</section>
  <div class="pane-gutter pane-gutter-col" data-gutter="split" role="separator" aria-orientation="vertical" aria-label="Resize problem and editor panes" tabindex="0"></div>
  <section class="card practice-workbench" id="editor"><div class="editor-toolbar"><div><strong>{artifact.starterFile}</strong><span class="save-status" data-save-state aria-live="polite">Saved</span></div><div class="button-row">{artifact.browserRunnable?<button class="button" type="button" data-run>Run</button>:<Badge tone="amber">Run locally</Badge>}<button class="button secondary" type="button" data-save>Save</button><button class="button secondary danger" type="button" data-reset-code>Reset</button></div></div>{!artifact.browserRunnable&&<div class="callout"><strong>This dependency stack is local-only.</strong><p>Browser execution is intentionally disabled; your draft still autosaves here.</p><code>{artifact.localCommand}</code><div class="button-row" style="margin-top:10px"><button class="button secondary" type="button" data-copy-command data-command={artifact.localCommand}>Copy command</button></div></div>}<div class="code-editor" data-editor aria-label={`${artifact.language} code editor`}></div><div class="pane-gutter pane-gutter-row" data-gutter="tests" role="separator" aria-orientation="horizontal" aria-label="Resize editor and test results" tabindex="0"></div><section class="test-panel" aria-live="polite"><div class="test-panel-head"><strong>Test results</strong><span data-run-status>{artifact.browserRunnable?'Ready':'Local execution required'}</span></div><pre data-output>Run the solution to see structured output.</pre><div data-results></div><button class="button secondary" type="button" data-mark-complete={item.canonicalKey} hidden>Mark completed</button></section></section>
</div><nav class="practice-nav" aria-label="Problem navigation">{previous?<a class="button secondary" href={link(`/practice/${encodeURIComponent(previous.canonicalKey)}/`)}>← {previous.id}</a>:<span/>}<a class="button secondary" href={link('/practice/')}>Problem picker</a>{next?<a class="button secondary" href={link(`/practice/${encodeURIComponent(next.canonicalKey)}/`)}>{next.id} →</a>:<span/>}</nav>
<script>import { initPracticePage } from '@/scripts/practice'; initPracticePage();</script></AppLayout>
