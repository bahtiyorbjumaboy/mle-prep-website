---
import AppLayout from '@/layouts/AppLayout.astro'; import EmptyState from '@/components/EmptyState.astro'; import Badge from '@/components/Badge.astro'; import { index,curriculumLabel } from '@/lib/data'; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<AppLayout title="Notes"><header class="page-head"><div><p class="eyebrow">Session archive</p><h1>Study notes</h1><p>Chronological study evidence, kept separate from reusable lessons and current browser mastery.</p></div></header>{index.notes.length===0?<EmptyState title="No study notes yet" message="Add session-note Markdown under curriculum/<year>/notes with a non-empty items list. Backlinks appear automatically."/>:<div class="item-list">{index.notes.map(x=><a class="item-row" href={`${base}/notes/${x.slug}/`}><span class="item-id">{x.date||'NOTE'}</span><span><span class="item-title">{x.title}</span><span class="item-meta">{curriculumLabel(x.curriculum)} · {x.items.join(', ')}</span></span><Badge>{x.sessionType||'session'}</Badge></a>)}</div>}</AppLayout>
