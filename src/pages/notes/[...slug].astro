---
import AppLayout from '@/layouts/AppLayout.astro'; import { index,itemByKey,itemHref,curriculumLabel } from '@/lib/data'; import { renderMarkdown } from '@/lib/markdown';
export function getStaticPaths(){return index.notes.map(page=>({params:{slug:page.slug},props:{page}}));} const { page }=Astro.props; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const linked=page.items.map((x:string)=>itemByKey.get(x)).filter(Boolean);
const noteHtml = await renderMarkdown(page.markdown);
---
<AppLayout title={page.title}><header class="page-head"><div><p class="eyebrow">Session Note · {curriculumLabel(page.curriculum)}</p><h1>{page.title}</h1><p>{[page.date,page.sessionType].filter(Boolean).join(' · ')}</p></div><a class="button secondary" href={`${base}/notes/`}>All notes</a></header><div class="detail-grid"><article class="card detail-main prose" set:html={noteHtml}/><aside class="card detail-side"><div class="callout"><strong>Historical evidence</strong><p style="margin-bottom:0;color:var(--muted)">Observed mastery and sprint results do not replace current browser progress.</p></div><h2>Related items</h2>{linked.map((item:any)=><a class="item-row" style="grid-template-columns:55px 1fr" href={`${base}${itemHref(item.canonicalKey)}`}><span class="item-id">{item.id}</span><span class="item-title">{'bank' in item?item.titleOrQuestion:item.title}</span></a>)}</aside></div></AppLayout>
