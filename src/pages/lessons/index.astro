---
import AppLayout from '@/layouts/AppLayout.astro'; import EmptyState from '@/components/EmptyState.astro'; import Badge from '@/components/Badge.astro'; import { index,curriculumLabel } from '@/lib/data'; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<AppLayout title="Lessons"><header class="page-head"><div><p class="eyebrow">Reference library</p><h1>Lessons</h1><p>Concept-scoped, reusable teaching material with many-to-many curriculum links.</p></div></header>{index.lessons.length===0?<EmptyState title="No lessons written yet" message="Create one with npm run new:lesson -- 2026:bank01:A3, then extend its items list when the concept serves more questions or problems."/>:<div class="item-list">{index.lessons.map(x=><a class="item-row" href={`${base}/lessons/${x.slug}/`}><span class="item-id">LESSON</span><span><span class="item-title">{x.title}</span><span class="item-meta">{curriculumLabel(x.curriculum)} · {x.items.join(', ')}</span></span><Badge tone="blue">{x.id}</Badge></a>)}</div>}</AppLayout>
