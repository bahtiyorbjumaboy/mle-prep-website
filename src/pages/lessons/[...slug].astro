---
import AppLayout from '@/layouts/AppLayout.astro'; import Badge from '@/components/Badge.astro'; import { index,itemByKey,itemHref,curriculumLabel } from '@/lib/data'; import { renderMarkdown } from '@/lib/markdown';
export function getStaticPaths(){return index.lessons.map(page=>({params:{slug:page.slug},props:{page}}));} const { page }=Astro.props; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const linked=page.items.map((x:string)=>itemByKey.get(x)).filter(Boolean);
const lessonHtml = await renderMarkdown(page.markdown);
---
<AppLayout title={page.title}><header class="page-head"><div><p class="eyebrow">Lesson · {curriculumLabel(page.curriculum)}</p><h1>{page.title}</h1><p class="source-path">{page.path}</p></div><a class="button secondary" href={`${base}/lessons/`}>All lessons</a></header><div class="detail-grid"><article class="card detail-main prose" set:html={lessonHtml}/><aside class="card detail-side"><h2 style="margin-top:0">Linked items</h2>{linked.map((item:any)=><a class="item-row" style="grid-template-columns:55px 1fr" href={`${base}${itemHref(item.canonicalKey)}`}><span class="item-id">{item.id}</span><span class="item-title">{'bank' in item?item.titleOrQuestion:item.title}</span></a>)}{linked.length===0&&<p class="lede">No valid item mapping found.</p>}<div class="callout"><Badge tone="blue">MARKDOWN</Badge><p style="margin-bottom:0">Edit the source lesson file and rebuild; this page updates automatically.</p></div></aside></div><script>import mermaid from 'mermaid'; mermaid.initialize({startOnLoad:true,theme:document.documentElement.dataset.theme==='dark'?'dark':'default'});</script></AppLayout>
