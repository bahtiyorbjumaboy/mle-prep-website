---
import AppLayout from '@/layouts/AppLayout.astro'; import EmptyState from '@/components/EmptyState.astro'; import Badge from '@/components/Badge.astro';
import { index,itemByKey,itemHref,curriculumLabel } from '@/lib/data'; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const domains=[...new Set(index.codingReviews.map(x=>{const item=itemByKey.get(x.item||'');return item&&!('bank' in item)?item.track:''}).filter(Boolean))];
---
<AppLayout title="Coding Reviews"><header class="page-head"><div><p class="eyebrow">Durable study artifacts</p><h1>Coding reviews</h1><p>Reusable solution reviews associated one-to-one with canonical coding problems.</p></div></header>{index.codingReviews.length===0?<EmptyState title="No coding reviews yet" message="Add a contract-compliant Markdown file under a curriculum coding-reviews directory."/>:<><div class="filter-bar"><input type="search" placeholder="Search title, item, concept, or review…" data-filter="text"/><select data-filter="curriculum"><option value="">All curricula</option>{index.curricula.filter(c=>c.id!=='sprint').map(c=><option value={c.id}>{c.label}</option>)}</select><select data-filter="domain"><option value="">All domains</option>{domains.map(x=><option>{x}</option>)}</select></div><div class="item-list">{index.codingReviews.map(review=>{const item=itemByKey.get(review.item||'');const domain=item&&!('bank' in item)?item.track:'';return <article class="item-row" data-filter-item data-search={`${review.title} ${review.declaredItems.join(' ')} ${review.tags.join(' ')} ${review.markdown}`.toLowerCase()} data-curriculum={review.curriculum} data-domain={domain}><a class="item-id" href={`${base}/coding-reviews/${review.slug}/`}>{item?.id||'REVIEW'}</a><a href={`${base}/coding-reviews/${review.slug}/`}><div class="item-title">{review.title}</div><div class="item-meta">{curriculumLabel(review.curriculum)} · {domain} · Updated {review.updated}</div></a><div class="item-actions"><Badge tone="blue">Coding Review</Badge>{item&&<a class="button secondary" href={`${base}${itemHref(item.canonicalKey)}`}>Problem</a>}</div></article>})}</div></>}</AppLayout>
