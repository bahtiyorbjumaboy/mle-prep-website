---
import AppLayout from '@/layouts/AppLayout.astro'; import Badge from '@/components/Badge.astro'; import { index,itemHref,curriculumLabel,bankLabel } from '@/lib/data'; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const results=[...index.knowledgeItems.map(x=>({type:'Knowledge',title:x.titleOrQuestion,context:`${curriculumLabel(x.curriculum)} · ${bankLabel(x.curriculum,x.bank)}`,id:x.id,href:itemHref(x.canonicalKey),text:`${x.id} ${x.titleOrQuestion} ${x.rawSection}`})),...index.codingItems.map(x=>({type:'Coding',title:x.title,context:`${curriculumLabel(x.curriculum)} · ${x.track}`,id:x.id,href:itemHref(x.canonicalKey),text:`${x.id} ${x.title} ${x.prompt||''} ${x.concepts.join(' ')}`})),...index.interviewAnswers.map(x=>({type:'Interview Answer',title:x.title,context:`${curriculumLabel(x.curriculum)} · ${x.declaredItems.join(', ')}`,id:'Answer',href:`/interview-answers/${x.slug}/`,text:`${x.title} ${x.markdown} ${x.declaredItems.join(' ')} ${x.tags.join(' ')}`})),...index.codingSolutions.map(x=>({type:'Coding Solution',title:x.title,context:`${curriculumLabel(x.curriculum)} · ${x.language}`,id:x.filename,href:`/coding-solutions/${x.slug}/`,text:`${x.title} ${x.filename} ${x.code} ${x.item||''}`})),...index.sources.map(x=>({type:'Source',title:x.title,context:`${curriculumLabel(x.curriculum)} · ${x.role}`,id:'Source',href:`/sources/${x.curriculum}/${x.filename.replace(/\.mdx?$/,'')}/`,text:`${x.title} ${x.markdown}`}))];
---
<AppLayout title="Search"><header class="page-head"><div><p class="eyebrow">Global search</p><h1>Find anything in your interview OS.</h1><p>Search questions, problems, durable answers and coding solutions, and original source documents.</p></div></header><div class="filter-bar"><input style="font-size:16px;padding:11px" autofocus type="search" placeholder="Try “conditional independence”, “REC-05”, or “latency”…" data-search-input aria-label="Search all content"/></div><p class="lede" data-search-summary>Type two or more characters to search {results.length} records.</p><div class="item-list" data-search-results>{results.map(result=><a class="item-row" data-search-result data-text={result.text.toLowerCase()} href={`${base}${result.href}`} hidden><span class="item-id">{result.id}</span><span><span class="item-title">{result.title}</span><span class="item-meta">{result.context}</span></span><Badge tone="blue">{result.type}</Badge></a>)}</div><script>const input=document.querySelector<HTMLInputElement>('[data-search-input]');const rows=[...document.querySelectorAll<HTMLElement>('[data-search-result]')];const summary=document.querySelector<HTMLElement>('[data-search-summary]');input?.addEventListener('input',()=>{const query=input.value.trim().toLowerCase();let count=0;for(const row of rows){const show=query.length>=2&&(row.dataset.text||'').includes(query);row.hidden=!show;if(show)count++}if(summary)summary.textContent=query.length<2?`Type two or more characters to search ${rows.length} records.`:`${count} result${count===1?'':'s'} for “${input.value.trim()}”`;});</script></AppLayout>
