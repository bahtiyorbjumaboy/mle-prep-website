---
import AppLayout from '@/layouts/AppLayout.astro'; import EmptyState from '@/components/EmptyState.astro'; import Badge from '@/components/Badge.astro';
import { index,itemByKey,itemHref,curriculumLabel } from '@/lib/data'; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const domains=[...new Set(index.codingSolutions.map(x=>{const item=itemByKey.get(x.item||'');return item&&!('bank' in item)?item.track:''}).filter(Boolean))];
---
<AppLayout title="Coding Solutions"><header class="page-head"><div><p class="eyebrow">Executable study artifacts</p><h1>Coding solutions</h1><p>Complete source files associated one-to-one with canonical coding problems.</p></div></header>{index.codingSolutions.length===0?<EmptyState title="No coding solutions yet" message="Add a code file named after its problem ID under a curriculum coding-solutions directory."/>:<><div class="filter-bar"><input type="search" placeholder="Search title, problem ID, filename, or code…" data-filter="text"/><select data-filter="curriculum"><option value="">All curricula</option>{index.curricula.map(c=><option value={c.id}>{c.label}</option>)}</select><select data-filter="domain"><option value="">All domains</option>{domains.map(x=><option>{x}</option>)}</select></div><div class="item-list">{index.codingSolutions.map(solution=>{const item=itemByKey.get(solution.item||'');const domain=item&&!('bank' in item)?item.track:'';return <article class="item-row" data-filter-item data-search={`${solution.title} ${solution.filename} ${solution.code}`.toLowerCase()} data-curriculum={solution.curriculum} data-domain={domain}><a class="item-id" href={`${base}/coding-solutions/${solution.slug}/`}>{item?.id||'CODE'}</a><a href={`${base}/coding-solutions/${solution.slug}/`}><div class="item-title">{solution.title}</div><div class="item-meta">{curriculumLabel(solution.curriculum)} · {domain} · {solution.filename}</div></a><div class="item-actions"><Badge tone="blue">{solution.language}</Badge>{item&&<a class="button secondary" href={`${base}${itemHref(item.canonicalKey)}`}>Problem</a>}</div></article>})}</div></>}</AppLayout>
