---
import AppLayout from '@/layouts/AppLayout.astro'; import Badge from '@/components/Badge.astro'; import { index,itemByKey,itemHref,curriculumLabel } from '@/lib/data';
export function getStaticPaths(){return index.codingSolutions.map(solution=>({params:{slug:solution.slug},props:{solution}}));}
const {solution}=Astro.props; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const item=itemByKey.get(solution.item||'');
---
<AppLayout title={solution.title}><header class="page-head"><div><p class="eyebrow">Coding Solution · {curriculumLabel(solution.curriculum)}</p><h1>{solution.title}</h1><p class="source-path">{solution.path}</p></div><a class="button secondary" href={`${base}/coding-solutions/`}>All solutions</a></header><div class="detail-grid"><article class="card detail-main"><pre class="code-file"><code class={`language-${solution.language}`}>{solution.code}</code></pre></article><aside class="card detail-side"><Badge tone="blue">{solution.language}</Badge><dl class="metadata"><div><dt>File</dt><dd>{solution.filename}</dd></div><div><dt>Item</dt><dd>{solution.item}</dd></div></dl>{item&&<a class="item-row" style="grid-template-columns:70px 1fr;margin-top:18px" href={`${base}${itemHref(item.canonicalKey)}`}><span class="item-id">{item.id}</span><span class="item-title">{'bank' in item?item.titleOrQuestion:item.title}</span></a>}<div class="callout"><strong>Rendered from source</strong><p style="margin-bottom:0;color:var(--muted)">Edit the code file and rebuild to update this page.</p></div></aside></div></AppLayout>
