---
import AppLayout from '@/layouts/AppLayout.astro'; import Badge from '@/components/Badge.astro'; import ReadingControls from '@/components/ReadingControls.astro'; import { index,itemByKey,itemHref,curriculumLabel } from '@/lib/data'; import { renderMarkdown } from '@/lib/markdown';
export function getStaticPaths(){return index.sources.map(doc=>({params:{slug:`${doc.curriculum}/${doc.filename.replace(/\.mdx?$/,'')}`},props:{doc}}));} const { doc }=Astro.props; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const sourceHtml = await renderMarkdown(doc.markdown);
---
<AppLayout title={doc.title}><header class="page-head"><div><p class="eyebrow">{curriculumLabel(doc.curriculum)} · Source document</p><h1>{doc.title}</h1><p class="source-path">{doc.path}</p></div><div class="button-row"><ReadingControls/><a class="button secondary" href={`${base}/sources/`}>Source library</a></div></header><div class="detail-grid"><article class="card detail-main prose" set:html={sourceHtml}/><aside class="card detail-side"><Badge tone="blue">{doc.role}</Badge><h2>Indexed from this file</h2>{doc.indexedKeys.length?<div class="id-links">{doc.indexedKeys.map((key:string)=>{const item=itemByKey.get(key);return item?<a href={`${base}${itemHref(key)}`}>{item.id}</a>:null})}</div>:<p class="lede">This document has no indexed item headings.</p>}<div class="callout"><strong>Canonical source</strong><p style="margin-bottom:0;color:var(--muted)">The build reads this file but never edits it.</p></div></aside></div><script>import mermaid from 'mermaid'; mermaid.initialize({startOnLoad:true,theme:document.documentElement.dataset.theme==='dark'?'dark':'default'});</script></AppLayout>
