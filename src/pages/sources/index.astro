---
import AppLayout from '@/layouts/AppLayout.astro'; import EmptyState from '@/components/EmptyState.astro'; import Badge from '@/components/Badge.astro'; import { index,curriculumLabel } from '@/lib/data'; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<AppLayout title="Sources"><header class="page-head"><div><p class="eyebrow">Source library</p><h1>Canonical curriculum documents</h1><p>Original Markdown stays authoritative. Structured pages link back here for full context.</p></div></header>{index.sources.length===0?<EmptyState title="The source library is empty" message="Copy canonical .md files into curriculum/2026/sources, curriculum/2027/sources, or curriculum/sprint/sources. Files are rendered without being modified."/>:['2026','2027','sprint'].map((curriculum:string)=>{const docs=index.sources.filter(x=>x.curriculum===curriculum);return docs.length>0&&<section><div class="section-title"><h2>{curriculumLabel(curriculum)}</h2><Badge>{docs.length} documents</Badge></div><div class="grid grid-2">{docs.map(doc=><a class="card card-pad" href={`${base}/sources/${doc.curriculum}/${doc.filename.replace(/\.mdx?$/,'')}/`}><Badge tone="blue">{doc.role.replace('-',' ')}</Badge><h2>{doc.title}</h2><p class="source-path">{doc.filename}</p><p class="lede">{doc.indexedKeys.length} indexed items</p></a>)}</div></section>})}</AppLayout>
