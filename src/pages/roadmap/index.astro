---
import AppLayout from '@/layouts/AppLayout.astro'; import EmptyState from '@/components/EmptyState.astro';
import { index,resolveDisplayId,itemHref,curriculumLabel } from '@/lib/data'; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const link=(p:string)=>`${base}${p}`;
---
<AppLayout title="Roadmap"><header class="page-head"><div><p class="eyebrow">Roadmap</p><h1>Your curriculum, in execution order.</h1><p>Expand a week to see its source-backed work, milestones, and review requirements.</p></div></header>
{index.roadmapWeeks.length===0?<EmptyState title="No roadmap detected" message="Add a Markdown source file with “Roadmap” in its filename and Week headings. The parser will build this view from the real schedule."/>:<><div class="filter-bar"><select data-filter="curriculum"><option value="">All curricula</option>{index.curricula.map(c=><option value={c.id}>{c.label}</option>)}</select><label class="check-field"><input type="checkbox" data-filter="incomplete"/> Incomplete weeks</label></div>
<div class="item-list">{index.roadmapWeeks.map((week,i)=>{const refs=[...week.knowledgeItems,...week.codingItems].map(id=>resolveDisplayId(week.curriculum,id));const keys=refs.filter(Boolean).map(x=>x!.canonicalKey);return <details class="card week-card" open={i===0} data-filter-item data-progress-key={keys[0]||''} data-count-items={JSON.stringify(keys)} data-curriculum={week.curriculum}><summary class="week-summary"><div class="week-number">Week {week.weekNumber}</div><div><div class="week-title">{week.title}</div><div class="item-meta">{curriculumLabel(week.curriculum)}{week.dateRange?` · ${week.dateRange}`:''}</div></div><div style="min-width:180px"><div class="metric-sub"><span><span data-done>0</span>/<span data-total>{keys.length}</span> complete</span><strong data-percent>0%</strong></div><div class="progress-track"><div class="progress-bar" data-bar></div></div></div></summary><div class="week-details"><div class="week-columns"><section><h3>Knowledge</h3><div class="id-links">{week.knowledgeItems.map(id=>{const item=resolveDisplayId(week.curriculum,id);return item?<a href={link(itemHref(item.canonicalKey))}>{id}</a>:<span title="Unknown or ambiguous reference">{id} ?</span>})}</div></section><section><h3>Coding</h3><div class="id-links">{week.codingItems.map(id=>{const item=resolveDisplayId(week.curriculum,id);return item?<a href={link(itemHref(item.canonicalKey))}>{id}</a>:<span title="Unknown reference">{id} ?</span>})}</div></section></div>{[['Tasks',week.tasks],['Milestones & gates',week.milestones],['Review requirements',week.reviewRequirements],['Interview prompts',week.interviewProblems]].map(([title,items])=>Array.isArray(items)&&items.length>0&&<section><h3>{title}</h3><ul>{items.map(x=><li>{x}</li>)}</ul></section>)}</div></details>})}</div></>}
</AppLayout>
