---
import AppLayout from '@/layouts/AppLayout.astro'; import EmptyState from '@/components/EmptyState.astro'; import Badge from '@/components/Badge.astro';
import { index, itemHref, curriculumLabel } from '@/lib/data';
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); const link=(p:string)=>`${base}${p}`;
const banks=[...new Set(index.knowledgeItems.map(x=>x.bank))]; const depths=[...new Set(index.knowledgeItems.map(x=>x.depth).filter(Boolean))]; const phases=[...new Set(index.knowledgeItems.map(x=>x.phase).filter(Boolean))];
---
<AppLayout title="Knowledge"><header class="page-head"><div><p class="eyebrow">Knowledge browser</p><h1>Build depth, one question at a time.</h1><p>{index.knowledgeItems.length} questions indexed from canonical curriculum sources.</p></div></header>
{index.knowledgeItems.length===0?<EmptyState/>:<><div class="filter-bar"><input type="search" placeholder="Search question, topic, or ID…" aria-label="Search knowledge" data-filter="text"/><select data-filter="curriculum" aria-label="Curriculum"><option value="">All curricula</option>{index.curricula.map(c=><option value={c.id}>{c.label}</option>)}</select><select data-filter="bank" aria-label="Bank"><option value="">All domains</option>{banks.map(x=><option>{x}</option>)}</select><select data-filter="depth" aria-label="Depth"><option value="">All depths</option>{depths.map(x=><option>{x}</option>)}</select><select data-filter="phase" aria-label="Phase"><option value="">All phases</option>{phases.map(x=><option>{x}</option>)}</select><label class="check-field"><input type="checkbox" data-filter="incomplete"/> Incomplete only</label></div>
<p class="item-meta" data-filter-summary>{index.knowledgeItems.length} of {index.knowledgeItems.length} items</p>
<div class="item-list">{index.knowledgeItems.map(item=><article class="item-row" data-filter-item data-progress-key={item.canonicalKey} data-search={`${item.id} ${item.titleOrQuestion} ${item.bank}`.toLowerCase()} data-curriculum={item.curriculum} data-bank={item.bank} data-depth={item.depth||''} data-phase={item.phase||''}><a class="item-id" href={link(itemHref(item.canonicalKey))}>{item.id}</a><a href={link(itemHref(item.canonicalKey))}><div class="item-title">{item.titleOrQuestion}</div><div class="item-meta">{curriculumLabel(item.curriculum)} · {item.bank}{item.scheduledWeeks.length?` · Week ${item.scheduledWeeks.join(', ')}`:''}</div></a><div class="item-actions">{item.depth&&<Badge tone="blue">{item.depth}</Badge>}<Badge><span data-status>Not started</span></Badge><button class="button secondary" data-toggle-complete={item.canonicalKey}>Toggle done</button></div></article>)}</div></>}
</AppLayout>
