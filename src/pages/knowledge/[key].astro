---
import AppLayout from '@/layouts/AppLayout.astro'; import Badge from '@/components/Badge.astro'; import ProgressControls from '@/components/ProgressControls.astro';
import { index,curriculumLabel } from '@/lib/data'; import { renderMarkdown } from '@/lib/markdown';
export function getStaticPaths(){return index.knowledgeItems.map(item=>({params:{key:item.canonicalKey},props:{item}}));}
const { item }=Astro.props; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const link=(p:string)=>`${base}${p}`;
const answer=index.interviewAnswers.find(x=>x.item===item.canonicalKey); const lessons=index.lessons.filter(x=>x.items.includes(item.canonicalKey)); const notes=index.notes.filter(x=>x.items.includes(item.canonicalKey)); const source=index.sources.find(x=>x.path===item.sourceFile); const sourceSlug=source?`${source.curriculum}/${source.filename.replace(/\.mdx?$/,'')}`:'';
const questionHtml = await renderMarkdown(item.rawSection);
---
<AppLayout title={`${item.id} · Knowledge`}><header class="page-head"><div><p class="eyebrow">{curriculumLabel(item.curriculum)} · {item.bank}</p><h1>{item.id}: {item.titleOrQuestion}</h1><p class="source-path">{item.canonicalKey}</p></div><div class="button-row">{answer&&<a class="button" href={link(`/interview-answers/${answer.slug}/`)}>Interview answer</a>}{lessons[0]&&<a class="button secondary" href={link(`/lessons/${lessons[0].slug}/`)}>Lessons ({lessons.length})</a>}<a class="button secondary" href={link('/knowledge/')}>Back to bank</a></div></header>
<div class="detail-grid"><article class="card detail-main"><div class="tabs"><a class="active" href="#question">Question</a>{answer&&<a href={link(`/interview-answers/${answer.slug}/`)}>Interview Answer</a>}{lessons.length>0&&<a href="#lessons">Lessons ({lessons.length})</a>}{notes.length>0&&<a href="#notes">Notes ({notes.length})</a>}</div><div id="question" class="prose" set:html={questionHtml} />{answer&&<section><h2>Interview Answer</h2><a class="item-row" href={link(`/interview-answers/${answer.slug}/`)}><span class="item-id">ANSWER</span><span class="item-title">{answer.title}</span><Badge tone="blue">Updated {answer.updated}</Badge></a></section>}{lessons.length>0&&<section id="lessons"><h2>Related Lessons</h2><div class="item-list">{lessons.map(lesson=><a class="item-row" href={link(`/lessons/${lesson.slug}/`)}><span class="item-id">LESSON</span><span class="item-title">{lesson.title}</span><Badge>{lesson.id}</Badge></a>)}</div></section>}{notes.length>0&&<section id="notes"><h2>Session Notes</h2><div class="item-list">{notes.map(note=><a class="item-row" href={link(`/notes/${note.slug}/`)}><span class="item-id">{note.date||'NOTE'}</span><span class="item-title">{note.title}</span><Badge>{note.sessionType||'session'}</Badge></a>)}</div></section>}</article>
<aside class="card detail-side"><h2 style="margin-top:0">Item details</h2><dl class="metadata"><div><dt>Curriculum</dt><dd>{item.curriculum}</dd></div><div><dt>Bank</dt><dd>{item.bank}</dd></div><div><dt>Depth</dt><dd>{item.depth||'—'}</dd></div><div><dt>Phase</dt><dd>{item.phase||'—'}</dd></div><div><dt>Scheduled</dt><dd>{item.scheduledWeeks.length?item.scheduledWeeks.map((x:number)=>`W${x}`).join(', '):'—'}</dd></div><div><dt>Source</dt><dd>{source?<a style="color:var(--brand)" href={link(`/sources/${sourceSlug}/`)}>{source.filename}</a>:item.sourceFile}</dd></div></dl>{item.prerequisites.length>0&&<><h3>Prerequisites</h3><p class="lede">{item.prerequisites.join(', ')}</p></>}{item.followUps.length>0&&<><h3>Required follow-ups</h3><p class="lede">{item.followUps.join(', ')}</p></>}<ProgressControls itemKey={item.canonicalKey} curriculum={item.curriculum}/></aside></div>
</AppLayout>
