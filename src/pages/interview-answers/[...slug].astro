---
import AppLayout from '@/layouts/AppLayout.astro'; import Badge from '@/components/Badge.astro'; import { index,itemByKey,itemHref,curriculumLabel } from '@/lib/data'; import { renderMarkdown } from '@/lib/markdown';
export function getStaticPaths(){return index.interviewAnswers.map(page=>({params:{slug:page.slug},props:{page}}));}
const {page}=Astro.props; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const item=itemByKey.get(page.item||''); const html=await renderMarkdown(page.markdown);
---
<AppLayout title={page.title}><header class="page-head"><div><p class="eyebrow">Interview Answer · {curriculumLabel(page.curriculum)}</p><h1>{page.title}</h1><p class="source-path">{page.path}</p></div><a class="button secondary" href={`${base}/interview-answers/`}>All answers</a></header><div class="detail-grid"><article class="card detail-main prose" set:html={html}/><aside class="card detail-side"><Badge tone="blue">Durable answer</Badge><dl class="metadata"><div><dt>Item</dt><dd>{page.declaredItems[0]}</dd></div><div><dt>Created</dt><dd>{page.created}</dd></div><div><dt>Updated</dt><dd>{page.updated}</dd></div><div><dt>Tags</dt><dd>{page.tags.join(', ')||'—'}</dd></div></dl>{item&&<a class="item-row" style="grid-template-columns:55px 1fr;margin-top:18px" href={`${base}${itemHref(item.canonicalKey)}`}><span class="item-id">{item.id}</span><span class="item-title">{'bank' in item?item.titleOrQuestion:item.title}</span></a>}<div class="callout"><strong>Progress-free artifact</strong><p style="margin-bottom:0;color:var(--muted)">Current mastery and review dates remain in browser progress.</p></div></aside></div></AppLayout>
