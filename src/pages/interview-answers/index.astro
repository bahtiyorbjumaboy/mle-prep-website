---
import AppLayout from '@/layouts/AppLayout.astro'; import EmptyState from '@/components/EmptyState.astro'; import Badge from '@/components/Badge.astro';
import { index,itemByKey,itemHref,curriculumLabel } from '@/lib/data';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const domains=[...new Set(index.interviewAnswers.map(x=>{const item=itemByKey.get(x.item||'');return item&&'bank' in item?item.bank:''}).filter(Boolean))];
---
<AppLayout title="Interview Answers"><header class="page-head"><div><p class="eyebrow">Durable study artifacts</p><h1>Interview answers</h1><p>Reusable answers linked one-to-one with canonical knowledge questions. Live mastery remains browser-local.</p></div></header>{index.interviewAnswers.length===0?<EmptyState title="No interview answers yet" message="Add a contract-compliant Markdown file under curriculum/2026/interview-answers or curriculum/2027/interview-answers."/>:<><div class="filter-bar"><input type="search" placeholder="Search title, item, tag, or answer…" data-filter="text"/><select data-filter="curriculum"><option value="">All curricula</option>{index.curricula.map(c=><option value={c.id}>{c.label}</option>)}</select><select data-filter="domain"><option value="">All domains</option>{domains.map(x=><option>{x}</option>)}</select></div><div class="item-list">{index.interviewAnswers.map(answer=>{const item=itemByKey.get(answer.item||'');const domain=item&&'bank' in item?item.bank:'';return <article class="item-row" data-filter-item data-search={`${answer.title} ${answer.declaredItems.join(' ')} ${answer.tags.join(' ')} ${answer.markdown}`.toLowerCase()} data-curriculum={answer.curriculum} data-domain={domain}><a class="item-id" href={`${base}/interview-answers/${answer.slug}/`}>{item?.id||'ANSWER'}</a><a href={`${base}/interview-answers/${answer.slug}/`}><div class="item-title">{answer.title}</div><div class="item-meta">{curriculumLabel(answer.curriculum)} · {domain} · Updated {answer.updated}</div></a><div class="item-actions"><Badge tone="blue">Interview Answer</Badge>{item&&<a class="button secondary" href={`${base}${itemHref(item.canonicalKey)}`}>Question</a>}</div></article>})}</div></>}</AppLayout>
