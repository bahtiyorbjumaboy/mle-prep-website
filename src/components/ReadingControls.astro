<div class="reading-controls" data-reading-controls role="group" aria-label="Reading text size">
  <span class="reading-controls-label">Text</span>
  <button type="button" data-reading-size-step="-1" aria-label="Decrease reading text size">A−</button>
  <output data-reading-size-label aria-live="polite">100%</output>
  <button type="button" data-reading-size-step="1" aria-label="Increase reading text size">A+</button>
</div>
